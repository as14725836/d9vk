# wine-stability.env — 线程与内存稳定性预设（source 进你的启动脚本）
#
#   . /path/to/wine-stability.env
#
# 本文件里的每个变量都标注了“来源”与“风险”，不确定就先保持注释状态。

# ============================================================
# 一、同步原语（对多线程游戏影响最大的一项）
# ============================================================
# 背景（已核实）：esync / fsync 不是 Wine 上游的东西 —— 上游 wine-9.4 的
# dlls/ntdll/unix/sync.c 里搜不到 fsync；它们是 Proton / Wine-Staging 的补丁。
# 你的构建是 wine-9.4-dxgi-tkg-stg，TKG 系一般带 Staging，所以很可能支持。
#
# 验证方法（不确认就别开，开了不支持只是没效果，不会坏）：
#   strings $(command -v wine) | grep -iE 'WINEESYNC|WINEFSYNC'
#   或启动后看日志里若出现 fsync 相关报错就说明不支持
WINEESYNC=1            # 基于 eventfd，降低多线程同步开销
export WINEESYNC
# WINEFSYNC=1          # 基于 futex，通常比 esync 更快；与 WINEESYNC 不要同时开
export WINEFSYNC
# WINEFSYNC_SPINCOUNT=0  # Proton 系构建才有；默认自旋，0 = 关自旋（省 CPU、略增延迟）
export WINEFSYNC_SPINCOUNT

# ============================================================
# 二、内存：防止把设备推入 swap 抖动（你这台可用内存偏紧）
# ============================================================
# glibc 线程 arena：Wine 进程线程多，默认每个 arena 都是一个独立堆，
# 不限制时很容易几十个 arena → 虚拟内存膨胀。限制为 2 是最经典的稳定化手段。
MALLOC_ARENA_MAX=2
export MALLOC_ARENA_MAX

# 同理，box64 自己也有内存挂件：
# BOX64_MALLOC_HACK=0   # 0=不用 hack（最稳）；1/2/3 逐级更激进，个别程序会崩
export BOX64_MALLOC_HACK

# DXVK 侧显存/内存限额（写进 dxvk.conf 更合适，这里列出对应键名）：
#   dxvk.maxMemoryBudget   = 0      （0=自动；内存紧张可设 1024~2048，单位 MB）
#   dxgi.maxDeviceMemory   = 0      （给游戏看的显存大小，不要调太大以免驱动超额承诺）
#   d3d9.textureMemory     = 100    （d3d9 纹理内存上限，默认 100=不限）

# ============================================================
# 三、线程数：8 核 big.LITTLE 上，“限制并发”往往比“放开”更稳
# ============================================================
BOX64_MAXCPU=8
export BOX64_MAXCPU
# 若游戏/翻译层开线程过多反而抖动，可试 6 或 4

# 翻译代码内存：BIGBLOCK 越大，生成代码越多、占用越大
#   内存充裕：BOX64_DYNAREC_BIGBLOCK=3（更快、更吃内存）
#   内存紧张：BOX64_DYNAREC_BIGBLOCK=1（更省内存、略慢，但更不容易触发 OOM/抖动）
export BOX64_DYNAREC_BIGBLOCK

# 关掉调试与日志（直接省 CPU 与内存）
WINEDEBUG=-all
export WINEDEBUG
DXVK_LOG_LEVEL=none
export DXVK_LOG_LEVEL

# ============================================================
# 四、崩溃时可诊断用（平时不要开，会写入大量日志）
# ============================================================
# WINEDEBUG=+seh         # 异常/崩溃栈
# DXVK_LOG_LEVEL=info    # 确认游戏到底走了 D3D9 还是 D3D11
