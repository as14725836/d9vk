diff --git a/src/dxvk/dxvk_adreno.h b/src/dxvk/dxvk_adreno.h
new file mode 100644
index 0000000..2493e47
--- /dev/null
+++ b/src/dxvk/dxvk_adreno.h
@@ -0,0 +1,58 @@
+#pragma once
+
+#include <cstdint>
+
+namespace dxvk {
+
+  /**
+   * \brief Qualcomm Adreno GPU generation
+   *
+   * Derived from the Vulkan device name reported by Turnip, because
+   * VkPhysicalDeviceProperties::deviceID is a 32 bit field while
+   * freedreno's chip_id is 48 bit wide.  The assignment in Turnip
+   * (props->deviceID = dev_id.chip_id) therefore truncates the upper
+   * 16 bits, which makes several distinct GPUs collide:
+   *
+   *   0x00be06030500  Adreno 8c Gen 3
+   *   0x007506030500  Adreno 7c+ Gen 3
+   *   0x006006030500  Adreno 7c+ Gen 3 Lite
+   *   0xffff06030500  Adreno 7c+ Gen 3
+   *
+   * All four report deviceID == 0x06030500.  Parsing the device name is
+   * the only reliable way to tell them apart from a Vulkan client.
+   */
+  enum class AdrenoGen : uint8_t {
+    Unknown = 0,
+    Gen6,   // A610 .. A690
+    Gen7,   // A702 .. A7xx, includes X1 series
+    Gen8,   // A810 .. A8xx, includes X2 series
+  };
+
+  /**
+   * \brief Parsed description of an Adreno GPU
+   */
+  struct AdrenoInfo {
+    AdrenoGen gen = AdrenoGen::Unknown;
+    /// Numeric model, e.g. 830 for "Adreno (TM) 830". Zero when the name
+    /// does not carry a usable number (e.g. "8c Gen 3").
+    uint32_t  model = 0u;
+    /// True for the "c" variants such as "7c+ Gen 3" / "8c Gen 3".
+    bool      isCFamily = false;
+    /// True for the "+" variants such as "7c+ Gen 3".
+    bool      isPlusVariant = false;
+  };
+
+  /**
+   * \brief Parses an Adreno device name
+   *
+   * Accepts the spellings produced by Turnip / freedreno:
+   *   "Adreno (TM) 830", "Turnip Adreno (TM) 830 (raytracing disabled)",
+   *   "Adreno 623", "Adreno 7c+ Gen 3", "Adreno 8c Gen 3",
+   *   "Adreno X1-85", "Adreno (TM) X2-90"
+   *
+   * \param [in] deviceName Device name from VkPhysicalDeviceProperties
+   * \returns Parsed info, with AdrenoGen::Unknown when not an Adreno GPU
+   */
+  AdrenoInfo parseAdrenoName(const char* deviceName);
+
+}
