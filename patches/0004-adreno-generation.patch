diff --git a/tests/adreno_test.cpp b/tests/adreno_test.cpp
new file mode 100644
index 0000000..7d9565b
--- /dev/null
+++ b/tests/adreno_test.cpp
@@ -0,0 +1,93 @@
+#include "dxvk_adreno.h"
+
+#include <cstdio>
+#include <cstring>
+
+using namespace dxvk;
+
+static int g_fail = 0;
+
+static const char* genName(AdrenoGen g) {
+  switch (g) {
+    case AdrenoGen::Gen6: return "Gen6";
+    case AdrenoGen::Gen7: return "Gen7";
+    case AdrenoGen::Gen8: return "Gen8";
+    default:              return "Unknown";
+  }
+}
+
+static void check(const char* name, AdrenoGen wantGen, uint32_t wantModel,
+                  bool wantC = false, bool wantPlus = false) {
+  AdrenoInfo info = parseAdrenoName(name);
+  bool ok = info.gen == wantGen
+         && info.model == wantModel
+         && info.isCFamily == wantC
+         && info.isPlusVariant == wantPlus;
+
+  printf("%s  %-46s gen=%-7s model=%-5u c=%d plus=%d\n",
+         ok ? "PASS" : "FAIL", name, genName(info.gen), info.model,
+         int(info.isCFamily), int(info.isPlusVariant));
+
+  if (!ok) {
+    printf("      expected gen=%-7s model=%-5u c=%d plus=%d\n",
+           genName(wantGen), wantModel, int(wantC), int(wantPlus));
+    g_fail++;
+  }
+}
+
+int main() {
+  printf("=== Adreno device name parsing ===\n\n");
+
+  /* Names as produced by Turnip for numeric models */
+  check("Adreno (TM) 623", AdrenoGen::Gen6, 623);
+  check("Adreno (TM) 704", AdrenoGen::Gen7, 704);
+  check("Adreno (TM) 722", AdrenoGen::Gen7, 722);
+  check("Adreno (TM) 735", AdrenoGen::Gen7, 735);
+  check("Adreno (TM) 753", AdrenoGen::Gen7, 753);
+  check("Adreno (TM) 810", AdrenoGen::Gen8, 810);
+  check("Adreno (TM) 829", AdrenoGen::Gen8, 829);
+  check("Adreno (TM) 830", AdrenoGen::Gen8, 830);
+  check("Adreno (TM) 830v1", AdrenoGen::Gen8, 830);
+  check("Adreno (TM) 840", AdrenoGen::Gen8, 840);
+
+  /* Turnip prefixes and suffixes */
+  check("Turnip Adreno (TM) 830", AdrenoGen::Gen8, 830);
+  check("Turnip Adreno (TM) 830 (raytracing disabled)", AdrenoGen::Gen8, 830);
+  check("Adreno 623", AdrenoGen::Gen6, 623);
+
+  /* "c" family names, which carry no plain model number */
+  check("Adreno 7c+ Gen 3", AdrenoGen::Gen7, 0, true, true);
+  check("Adreno 7c+ Gen 3 Lite", AdrenoGen::Gen7, 0, true, true);
+  check("Adreno 8c Gen 3", AdrenoGen::Gen8, 0, true, false);
+
+  /* X series (four digit naming) */
+  check("Adreno X1-85", AdrenoGen::Gen7, 1);
+  check("Adreno (TM) X2-90", AdrenoGen::Gen8, 2);
+
+  /* Non-Adreno and malformed names must not be mistaken for Adreno */
+  check("llvmpipe (LLVM 15.0.7, 256 bits)", AdrenoGen::Unknown, 0);
+  check("NVIDIA GeForce RTX 4090", AdrenoGen::Unknown, 0);
+  check("AMD Radeon RX 7900 XTX", AdrenoGen::Unknown, 0);
+  check("Intel(R) UHD Graphics 770", AdrenoGen::Unknown, 0);
+  check("", AdrenoGen::Unknown, 0);
+  check(nullptr, AdrenoGen::Unknown, 0);
+
+  /* Critical: the four GPUs that collide on deviceID == 0x06030500
+   * must still be distinguishable through the parsed info. */
+  printf("\n=== deviceID collision cases (all report 0x06030500) ===\n");
+  AdrenoInfo a = parseAdrenoName("Adreno 8c Gen 3");
+  AdrenoInfo b = parseAdrenoName("Adreno 7c+ Gen 3");
+  AdrenoInfo c = parseAdrenoName("Adreno 7c+ Gen 3 Lite");
+  printf("8c Gen 3       -> gen=%s c=%d\n", genName(a.gen), int(a.isCFamily));
+  printf("7c+ Gen 3      -> gen=%s c=%d plus=%d\n", genName(b.gen), int(b.isCFamily), int(b.isPlusVariant));
+  printf("7c+ Gen 3 Lite -> gen=%s c=%d plus=%d\n", genName(c.gen), int(c.isCFamily), int(c.isPlusVariant));
+  if (a.gen == b.gen) {
+    printf("FAIL  8c and 7c+ resolve to the same generation\n");
+    g_fail++;
+  } else {
+    printf("PASS  8c(Gen8) and 7c+(Gen7) are distinguishable\n");
+  }
+
+  printf("\n%s  (%d failures)\n", g_fail ? "SOME TESTS FAILED" : "ALL TESTS PASSED", g_fail);
+  return g_fail ? 1 : 0;
+}
