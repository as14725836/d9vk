diff --git a/src/dxvk/dxvk_adreno.cpp b/src/dxvk/dxvk_adreno.cpp
new file mode 100644
index 0000000..f715f68
--- /dev/null
+++ b/src/dxvk/dxvk_adreno.cpp
@@ -0,0 +1,144 @@
+#include "dxvk_adreno.h"
+
+#include <cctype>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+
+namespace dxvk {
+
+  namespace {
+
+    /**
+     * \brief Lowercases a string, for case-insensitive matching
+     */
+    std::string toLower(const char* s) {
+      std::string result(s ? s : "");
+      for (auto& c : result)
+        c = char(std::tolower(static_cast<unsigned char>(c)));
+      return result;
+    }
+
+    /**
+     * \brief Extracts the first run of digits starting at or after \c pos
+     *
+     * \returns The parsed value, and advances \c pos past the digits.
+     */
+    uint32_t takeNumber(const std::string& s, size_t& pos) {
+      while (pos < s.size() && !std::isdigit(static_cast<unsigned char>(s[pos])))
+        pos++;
+
+      if (pos >= s.size())
+        return 0u;
+
+      uint32_t value = 0u;
+      while (pos < s.size() && std::isdigit(static_cast<unsigned char>(s[pos]))) {
+        value = value * 10u + uint32_t(s[pos] - '0');
+        pos++;
+      }
+      return value;
+    }
+
+  }
+
+
+  AdrenoInfo parseAdrenoName(const char* deviceName) {
+    AdrenoInfo info;
+
+    if (deviceName == nullptr)
+      return info;
+
+    const std::string name = toLower(deviceName);
+
+    /* Must be an Adreno GPU.  Turnip reports either "Adreno (...) NNN"
+     * directly, or a "Turnip Adreno (...)" prefix; both contain "adreno".
+     * freedreno also has "FD..." style names, but those never carry the
+     * vendor name, so they resolve to Unknown here. */
+    if (name.find("adreno") == std::string::npos)
+      return info;
+
+    /* Detect the "c" family, e.g. "7c+ gen 3" / "8c gen 3".  These names
+     * do not expose a plain model number, so the generation has to come
+     * from the leading digit instead. */
+    size_t pos = name.find("adreno");
+    pos += std::strlen("adreno");
+
+    /* Skip over "(tm)" and whitespace to reach the model token. */
+    while (pos < name.size() && (std::isspace(static_cast<unsigned char>(name[pos]))
+                              || name[pos] == '(' || name[pos] == ')'))
+      pos++;
+
+    if (pos < name.size() && name.compare(pos, 2, "tm") == 0) {
+      pos += 2;
+      while (pos < name.size() && (std::isspace(static_cast<unsigned char>(name[pos]))
+                                || name[pos] == '(' || name[pos] == ')'))
+        pos++;
+    }
+
+    if (pos >= name.size())
+      return info;
+
+    /* "c" families: "<digit>c" followed by optional "+", e.g. 7c+ / 8c.
+     * These names do not carry a plain model number, so the generation has
+     * to come from the trailing "gen N". */
+    if (std::isdigit(static_cast<unsigned char>(name[pos]))
+     && pos + 1 < name.size()
+     && name[pos + 1] == 'c') {
+      const uint32_t lead = uint32_t(name[pos] - '0');
+      info.isCFamily = true;
+
+      size_t p = pos + 2;
+      if (p < name.size() && name[p] == '+') {
+        info.isPlusVariant = true;
+        p++;
+      }
+
+      /* Search "gen N" only after the c/plus marker, otherwise the "gen"
+       * of a later word would be picked up. */
+      const size_t genPos = name.find("gen", p);
+      if (genPos != std::string::npos) {
+        size_t q = genPos + 3;
+        const uint32_t gen = takeNumber(name, q);
+        if (gen == 6u)      info.gen = AdrenoGen::Gen6;
+        else if (gen == 7u) info.gen = AdrenoGen::Gen7;
+        else if (gen == 8u) info.gen = AdrenoGen::Gen8;
+      }
+
+      /* Fall back to the leading digit when no usable "gen N" was found. */
+      if (info.gen == AdrenoGen::Unknown) {
+        if (lead == 6u)      info.gen = AdrenoGen::Gen6;
+        else if (lead == 7u) info.gen = AdrenoGen::Gen7;
+        else if (lead == 8u) info.gen = AdrenoGen::Gen8;
+      }
+      return info;
+    }
+
+    /* "X" series naming, e.g. "X1-85" / "X2-90".  The generation is encoded
+     * in the leading digit: X1 -> Gen7 (A7xx derived), X2 -> Gen8. */
+    if (name[pos] == 'x') {
+      size_t p = pos + 1;
+      const uint32_t series = takeNumber(name, p);
+      info.model = series;
+      if (series == 1u)      info.gen = AdrenoGen::Gen7;
+      else if (series == 2u) info.gen = AdrenoGen::Gen8;
+      return info;
+    }
+
+    /* Numeric model, e.g. "830" / "623" / "702". */
+    const uint32_t model = takeNumber(name, pos);
+    if (model == 0u)
+      return info;
+
+    info.model = model;
+
+    /* Three digit models map directly: A830 -> gen 8, A623 -> gen 6,
+     * A702 -> gen 7. */
+    const uint32_t lead = model / 100u;
+    if (lead == 6u)      info.gen = AdrenoGen::Gen6;
+    else if (lead == 7u) info.gen = AdrenoGen::Gen7;
+    else if (lead == 8u) info.gen = AdrenoGen::Gen8;
+
+    return info;
+  }
+
+}
