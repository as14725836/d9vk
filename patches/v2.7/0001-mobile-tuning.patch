diff --git a/src/dxvk/dxvk_memory.cpp b/src/dxvk/dxvk_memory.cpp
index 150bb4c..50b119b 100644
--- a/src/dxvk/dxvk_memory.cpp
+++ b/src/dxvk/dxvk_memory.cpp
@@ -2252,6 +2252,12 @@ namespace dxvk {
     if (!m_device->features().extMemoryBudget)
       return;
 
+    // [mobile-tuning patch] Mobile/tiler GPUs have no dedicated VRAM; keep
+    // headroom so the kernel OOM killer does not pick us. Default on; set
+    // dxvk.maxMemoryBudget to a value if you need the old behaviour.
+    const uint32_t vendorId = m_device->adapter()->deviceProperties().core.properties.vendorID;
+    const bool isMobileTiler = (vendorId == 0x5143u || vendorId == 0x13B5u || vendorId == 0x1010u);
+
     VkDeviceSize maxBudget = m_device->config().maxMemoryBudget;
 
     VkPhysicalDeviceMemoryBudgetPropertiesEXT memBudget = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MEMORY_BUDGET_PROPERTIES_EXT };
@@ -2279,6 +2285,10 @@ namespace dxvk {
 
           if (maxBudget)
             m_memHeaps[i].memoryBudget = std::min(m_memHeaps[i].memoryBudget, maxBudget);
+          if (!maxBudget && isMobileTiler) {
+            VkDeviceSize mobileReserved = m_memHeaps[i].properties.size / 5u;
+            m_memHeaps[i].memoryBudget -= std::min(mobileReserved, m_memHeaps[i].memoryBudget);
+          }
         }
       }
     }
diff --git a/src/dxvk/dxvk_pipemanager.cpp b/src/dxvk/dxvk_pipemanager.cpp
index b0b03f9..3e0acd6 100644
--- a/src/dxvk/dxvk_pipemanager.cpp
+++ b/src/dxvk/dxvk_pipemanager.cpp
@@ -91,8 +91,14 @@ namespace dxvk {
       if (env::is32BitHostPlatform())
         workerCount = std::min(workerCount, 16u);
 
-      if (m_device->config().numCompilerThreads > 0)
+      if (m_device->config().numCompilerThreads > 0) {
         workerCount = m_device->config().numCompilerThreads;
+      } else {
+        // [mobile-tuning patch] cap shader compiler workers on mobile/tiler GPUs
+        const uint32_t workerVendorId = m_device->adapter()->deviceProperties().core.properties.vendorID;
+        if (workerVendorId == 0x5143u || workerVendorId == 0x13B5u || workerVendorId == 0x1010u)
+          workerCount = std::min(workerCount, 4u);
+      }
 
       // Number of workers that can process pipeline pipelines with normal
       // priority. Any other workers can only build high-priority pipelines.
