diff --git a/src/d3d9/d3d9_constant_buffer.cpp b/src/d3d9/d3d9_constant_buffer.cpp
index 13bff17..765ced8 100644
--- a/src/d3d9/d3d9_constant_buffer.cpp
+++ b/src/d3d9/d3d9_constant_buffer.cpp
@@ -1,4 +1,5 @@
 #include "d3d9_constant_buffer.h"
+#include "../util/util_env.h"
 #include "d3d9_device.h"
 
 namespace dxvk {
@@ -261,6 +262,14 @@ namespace dxvk {
     if (option != Tristate::Auto)
       return option == Tristate::True;
 
+    // [turnip-tuning patch] Device-local (tiled) constant buffers are used by
+    // default on tiler drivers, which is the common case on Android.
+    // Explicit d3d9.deviceLocalConstantBuffers still wins, and
+    // DXVK_TURNIP_EXPERIMENTS=0 reverts to upstream behaviour.
+    const uint32_t vendorId = dxvkDevice->properties().core.properties.vendorID;
+    if (vendorId == 0x5143u || vendorId == 0x13B5u || vendorId == 0x1010u)
+      return env::getEnvVar("DXVK_TURNIP_EXPERIMENTS") != "0";
+
     return dxvkDevice->properties().core.properties.deviceType == VK_PHYSICAL_DEVICE_TYPE_DISCRETE_GPU;
   }
 
diff --git a/src/dxvk/dxvk_device.cpp b/src/dxvk/dxvk_device.cpp
index 0221825..f9a1b34 100644
--- a/src/dxvk/dxvk_device.cpp
+++ b/src/dxvk/dxvk_device.cpp
@@ -4,6 +4,7 @@
 #include "dxvk_latency_reflex.h"
 #include "dxvk_shader_cache.h"
 #include "dxvk_shader_ir.h"
+#include "../util/util_env.h"
 
 namespace dxvk {
   
@@ -745,6 +746,17 @@ namespace dxvk {
                              || (m_adapter->matchesDriver(VK_DRIVER_ID_MESA_RADV)
                               && m_properties.vk13.minSubgroupSize == 32u));
 
+    // [turnip-tuning patch] Tiler/mobile GPUs (Turnip, Qualcomm, Honeykrisp) get
+    // these two enabled by default because they are the common case on Android.
+    // Set DXVK_TURNIP_EXPERIMENTS=0 to fall back to upstream behaviour.
+    const bool mobileTilerHints =
+         m_adapter->matchesDriver(VK_DRIVER_ID_MESA_TURNIP)
+      || m_adapter->matchesDriver(VK_DRIVER_ID_QUALCOMM_PROPRIETARY)
+      || m_adapter->matchesDriver(VK_DRIVER_ID_MESA_HONEYKRISP);
+
+    if (mobileTilerHints && env::getEnvVar("DXVK_TURNIP_EXPERIMENTS") != "0")
+      hints.preferComputeMipGen = true;
+
     // On AMD we can expect it to be optimal to simply pass the heap offset
     // to descriptor memory through as-is to avoid some ALU. Some other
     // vendors are more sensitive towards knowing descriptor alignment.
@@ -752,6 +764,9 @@ namespace dxvk {
                                      || m_adapter->matchesDriver(VK_DRIVER_ID_AMD_OPEN_SOURCE)
                                      || m_adapter->matchesDriver(VK_DRIVER_ID_AMD_PROPRIETARY);
 
+    if (mobileTilerHints && env::getEnvVar("DXVK_TURNIP_EXPERIMENTS") != "0")
+      hints.preferDescriptorByteOffsets = true;
+
     return hints;
   }
 
