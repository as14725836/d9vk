diff --git a/src/dxvk/dxvk_presenter.cpp b/src/dxvk/dxvk_presenter.cpp
index f93ae8d..695e29e 100644
--- a/src/dxvk/dxvk_presenter.cpp
+++ b/src/dxvk/dxvk_presenter.cpp
@@ -43,7 +43,15 @@ namespace dxvk {
     // KHR and EXT variants of this extension are completely identical
     m_hasSwapchainMaintenance1 = m_device->features().khrSwapchainMaintenance1.swapchainMaintenance1
                               || m_device->features().extSwapchainMaintenance1.swapchainMaintenance1;
-
+    // [turnip-fence] Turnip (and third-party builds such as XmoBox) report
+    // swapchainMaintenance1 but their present-fence implementation is broken:
+    // the fence is never signaled, so waitForSwapchainFence() blocks forever
+    // with ~0ull timeout and the game hangs on a black screen (most visible
+    // after a D3D9 Device reset).  Fall back to the pre-2.5.x path that does
+    // not rely on present fences, matching the behaviour of DXVK 2.4.1 which
+    // is known to work on these drivers.
+    if (m_device->adapter()->matchesDriver(VK_DRIVER_ID_MESA_TURNIP))
+      m_hasSwapchainMaintenance1 = false;
     // Gamescope WSI is currently broken and doesn't properly signal
     // the present fence if presentation is queued but fails.
     // TODO Remove this hack when this gets fixed in stable SteamOS.
